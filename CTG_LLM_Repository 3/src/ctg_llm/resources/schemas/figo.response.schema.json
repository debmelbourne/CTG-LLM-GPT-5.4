    },
    "baseline": {
      "type": [
        "string",
        "null"
      ]
    },
    "variability": {
      "type": [
        "string",
        "null"
      ]
    },
    "accelerations": {
      "type": [
        "string",
        "null"
      ]
    },
    "decelerations": {
      "type": [
        "string",
        "null"
      ]
    },
    "contractions": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_limitations": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
