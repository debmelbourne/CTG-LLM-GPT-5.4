{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CTU-UHB signal rendering manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "generated_at_utc",
    "dataset",
    "outcome_fields_loaded",
    "absolute_paths_recorded",
    "parameters",
    "record_count",
    "records"
  ],
  "properties": {
    "manifest_version": {"const": "1.0.0"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "dataset": {"type": "string", "minLength": 1},
    "outcome_fields_loaded": {"const": false},
    "absolute_paths_recorded": {"const": false},
    "parameters": {"type": "object"},
    "record_count": {"type": "integer", "minimum": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "source_format",
          "source_files",
          "output_file",
          "output_sha256",
          "input_samples",
          "rendered_samples",
          "sample_period_ms"
        ],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "source_format": {"enum": ["wfdb", "csv"]},
          "source_files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["relative_path", "sha256"],
              "properties": {
                "relative_path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/).+"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "output_file": {"type": "string", "pattern": "^[^/]+\\.png$"},
          "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "input_samples": {"type": "integer", "minimum": 1},
          "rendered_samples": {"type": "integer", "minimum": 1},
          "sample_period_ms": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    }
  }
}
